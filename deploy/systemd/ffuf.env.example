# Install as /etc/mongrel/ffuf.env with root:root ownership and mode 0600.
# These non-secret production overrides load after /etc/mongrel/mongrel.env.
# Both paths are deployment-managed symlinks to SecLists wordlists and their
# symlink targets must be readable by the mongrel service user.
FFUF_WORDLIST_STANDARD_PATH=/home/mongrel/wordlists/ffuf-standard.txt
FFUF_WORDLIST_DEEP_PATH=/home/mongrel/wordlists/ffuf-deep.txt
