TELEGRAM_BOT_TOKEN=
ADMIN_USER_ID=
DATABASE_PATH=data/mongrel.db
AI_ENABLED=false
AI_PROVIDER=ollama
AI_TIMEOUT_SECONDS=120
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
NUCLEI_PATH=nuclei
TESTSSL_PATH=testssl.sh
GITLEAKS_PATH=gitleaks
BBOT_SCAN_TIMEOUT_SECONDS=600
NUCLEI_SCAN_TIMEOUT_SECONDS=600
NUCLEI_TAGS=exposure,misconfig,tech,panel,headers
NUCLEI_RATE_LIMIT=25
NUCLEI_REQUEST_TIMEOUT=5
NUCLEI_RETRIES=1
HTTPX_PATH=httpx
HTTPX_SCAN_TIMEOUT_SECONDS=120
KATANA_PATH=katana
KATANA_SCAN_TIMEOUT_SECONDS=180
KATANA_CRAWL_DEPTH=2
PLAYWRIGHT_SCAN_TIMEOUT_SECONDS=45
FFUF_PATH=ffuf
FFUF_SCAN_TIMEOUT_SECONDS=120
# Quick profile uses bundled ffuf_default.txt, a 19-entry smoke-test/minimal fallback list.
FFUF_WORDLIST_PATH=app/resources/wordlists/ffuf_default.txt
# Custom profile uses FFUF_WORDLIST_PATH.
# Standard and Deep profiles should point at vetted external wordlists for competition/production.
# Examples:
# FFUF_WORDLIST_STANDARD_PATH=/opt/SecLists/Discovery/Web-Content/directory-list-2.3-small.txt
# FFUF_WORDLIST_DEEP_PATH=/opt/SecLists/Discovery/Web-Content/raft-medium-directories.txt
FFUF_WORDLIST_STANDARD_PATH=
FFUF_WORDLIST_DEEP_PATH=
FFUF_THREADS=5
FFUF_RATE_LIMIT=25
APP_ENV=development
EVIDENCE_VAULT_KEY=
EVIDENCE_VAULT_PATH=data/evidence_vault.sqlite3
